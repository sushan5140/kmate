# --- gks-rag service configuration -------------------------------------------
# Every value below is optional; the service starts and answers with none of
# them set. Copy to .env only if you need to override a default.
#
# There are deliberately no host/port/URL settings here: the service binds
# whatever host and port the process manager passes to uvicorn, and it never
# calls back into KMate. KMate points at it via its own GKS_RAG_URL.

# Optional. Without it /ask returns retrieved evidence in readable form
# ("retrieval_only" mode). With it, answers are generated from that same
# evidence ("rag_generated"). This key must never be exposed to a browser --
# only KMate's server-side /api/gks/ask route talks to this service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# How many results each layer returns per query (1-15).
TOP_K=6

# --- Retrieval tuning (see app/settings.py for what each one does) ------------
# Boost when a record's category matches the category inferred from the question.
CATEGORY_BOOST=0.30
# Boost scaled by the share of the question's key concepts a record covers.
KEY_TERM_BOOST=0.45

# Minimum score for OFFICIAL evidence. Below this, no official evidence is
# returned and the UI shows "Official verification pending" -- preferred over
# presenting unrelated text under an authoritative heading.
OFFICIAL_MIN_SCORE=0.30
# When the question names specific concepts, require an official chunk to cover
# at least one of them ("0" disables).
OFFICIAL_REQUIRE_CONCEPT=1

# COMMUNITY evidence is a ranking preference, not a hard filter, so that
# general applicant experience still surfaces across tracks.
COMMUNITY_MIN_SCORE=0.03
COMMUNITY_PROGRAM_MATCH_BOOST=0.10
COMMUNITY_PROGRAM_MIXED_BOOST=0.05
COMMUNITY_PROGRAM_MISMATCH_PENALTY=0.25
