# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configure Google as an auth provider in Supabase Dashboard -> Authentication ->
# Providers -> Google (requires a Google Cloud OAuth client) -- see supabase/README.md

# The only email allowed to reach /admin/* and its API routes, regardless of
# any account's is_admin flag -- see isAuthorizedAdmin() in
# lib/supabase/auth-server.ts. Required for admin features to work at all.
ADMIN_EMAIL=

# Optional -- powers "Get feedback on delivery" on interview draft answers
# (rate-limited to 5/user/month). Without it, that one feature 501s; the rest
# of the app works fine.
ANTHROPIC_API_KEY=

# Shared secret for the notice-discovery cron route
# (GET/POST /api/cron/notices, Authorization: Bearer $CRON_SECRET). Vercel
# Cron sends this automatically when set as a project env var. Without it,
# only the signed-in ADMIN_EMAIL account can trigger a run.
CRON_SECRET=

# Base URL of the GKS RAG assistant service (see gks-rag/, a separate
# Python/FastAPI app) -- powers /gks. Required for that page's "Ask" button
# to work; without it, the API route 501s. Local dev: http://localhost:8000
# after running gks-rag's own setup (see gks-rag/README.md).
GKS_RAG_URL=
