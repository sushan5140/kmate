# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configure Google as an auth provider in Supabase Dashboard -> Authentication ->
# Providers -> Google (requires a Google Cloud OAuth client) -- see supabase/README.md

# The only email allowed to reach /admin/* and its API routes, regardless of
# any account's is_admin flag -- see isAuthorizedAdmin() in
# lib/supabase/auth-server.ts. Required for admin features to work at all.
ADMIN_EMAIL=

# Optional -- powers "Get feedback on delivery" on interview draft answers
# (rate-limited to 5/user/month). Without it, that one feature 501s; the rest
# of the app works fine.
ANTHROPIC_API_KEY=
