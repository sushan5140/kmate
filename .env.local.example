# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configure Google as an auth provider in Supabase Dashboard -> Authentication ->
# Providers -> Google (requires a Google Cloud OAuth client) -- see supabase/README.md

# The only email allowed to reach /admin/* and its API routes, regardless of
# any account's is_admin flag -- see isAuthorizedAdmin() in
# lib/supabase/auth-server.ts. Required for admin features to work at all.
ADMIN_EMAIL=

# Optional -- powers "Get feedback on delivery" on interview draft answers
# (rate-limited to 5/user/month). Without it, that one feature 501s; the rest
# of the app works fine.
ANTHROPIC_API_KEY=

# Shared secret for the notice-discovery cron route
# (GET/POST /api/cron/notices, Authorization: Bearer $CRON_SECRET). Vercel
# Cron sends this automatically when set as a project env var. Without it,
# only the signed-in ADMIN_EMAIL account can trigger a run.
CRON_SECRET=

# Powers the "new message" email notification (see /api/messages/notify).
# Sign up at resend.com, create an API key, and set a From address --
# "KMate <onboarding@resend.dev>" works immediately with no setup for
# testing, but a verified custom domain (Resend dashboard -> Domains) is
# strongly recommended before relying on this for real users: mail sent
# from an unverified domain is far more likely to land in spam, and
# onboarding@resend.dev visibly reads as a test address to recipients.
# Without RESEND_API_KEY or EMAIL_FROM, message sending itself still works
# fine -- the notify route just logs and skips (see lib/email/resend.ts).
RESEND_API_KEY=
EMAIL_FROM=

# Absolute base URL used to build the "View message" link in that email
# (e.g. https://kmate.vercel.app, no trailing slash). Without it, the notify
# route can't build a working link and skips sending -- again, the chat
# message itself is unaffected either way.
NEXT_PUBLIC_APP_URL=
